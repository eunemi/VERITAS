# Veritas backend configuration.
#
# Copy to `.env` and edit. `.env` is git-ignored; this file is committed and must
# never contain a real credential.
#
#     cp .env.example .env
#
# Every name here maps to a field on `Settings` in app/core/config.py. Anything
# left unset falls back to the default declared there, so a local run needs only
# the handful of lines marked REQUIRED. In a container or a deploy, set these as
# real environment variables and ship no .env at all.

# ============================================================== application ==
APP_NAME="Veritas Verification API"
APP_VERSION="0.1.0"

# local | development | staging | production
# Anything other than `local` requires JWT_SECRET_KEY, and `production` also
# closes /docs, forbids DEBUG, and rejects a "*" CORS origin.
ENVIRONMENT=local

# Never enable in production; the settings validator refuses to start if you do.
DEBUG=true

API_V1_PREFIX=/api/v1

# ================================================================== logging ==
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# json    — one object per line, for a log collector. The default.
# console — readable single line, for a terminal.
LOG_FORMAT=console

# ===================================================================== cors ==
# Comma-separated exact origins. The Next.js dev server is the default.
CORS_ORIGINS=http://localhost:3000

# ================================================================= database ==
# SQLAlchemy async URL — the driver is part of it. Under docker compose the host
# is `postgres`; running the API on the host against the compose database, it is
# `localhost`.
DATABASE_URL=postgresql+asyncpg://veritas:veritas@localhost:5432/veritas

# Log every statement. Very loud; useful for one debugging session, not a day.
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ===================================================================== auth ==
# REQUIRED whenever ENVIRONMENT is not `local`. Generate a fresh one per
# environment and store it in a secret manager, not here:
#
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Read by `create_refresh_token`, which nothing calls: there is no /auth/refresh
# endpoint yet, so ACCESS_TOKEN_EXPIRE_MINUTES is the session length today.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================================================================== llm ==
# openai | ollama
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# REQUIRED when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used when LLM_PROVIDER=ollama. No key; the base URL is the whole config.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# =================================================================== search ==
# Web research fans out over every provider in SEARCH_PROVIDERS at once, because
# "multiple independent websites" is the requirement and one index cannot
# corroborate itself. Comma-separated; tavily | serper | brave, in any order.
# Providers without a key are reported as skipped in every dossier rather than
# dropped silently, so a one-key deployment works and says so.
SEARCH_PROVIDERS=tavily,brave,serper

# The single provider get_search_client() resolves, for callers that want one
# engine. Web research ignores it.
SEARCH_PROVIDER=tavily

SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_RESULTS=10

# Total tries per request, not retries: 1 disables retrying. Only 429 and 5xx are
# retried.
SEARCH_ATTEMPTS=3

# Concurrent in-flight requests per provider. Low because these quotas are
# per-key and per-second on entry-level plans, and a burst that earns a 429 costs
# more time in backoff than the concurrency saved. Check your plan before raising.
SEARCH_CONCURRENCY=2

# Query formulations per claim, per provider: the claim itself, its terms, then
# its entities and figures alone. The cost is multiplicative — 3 queries × 3
# providers is 9 requests for one claim. Set to 1 to search only the claim as
# written.
SEARCH_QUERIES_PER_CLAIM=3

# Claims researched per request, at most. Ten at the defaults is ninety provider
# requests. What the ceiling cuts is named in the response, not omitted.
SEARCH_MAX_CLAIMS=10

# A key is needed for each provider listed in SEARCH_PROVIDERS. Two of the three
# is enough to corroborate; see app/search/serper.py, whose API contract could not
# be verified against live responses.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Which Tavily index to search: general | news | finance. `general` ranks primary
# documents — statute, filings, papers — which is what fact-checking wants. The
# cost is dates: Tavily returns published_date only on `news`.
TAVILY_TOPIC=general

# basic | advanced. `advanced` returns better-targeted chunks per credit spent.
TAVILY_SEARCH_DEPTH=basic

# =============================================================== fact check ==
# Searches Google's Fact Check Tools index for reviews already published on each
# claim, beside the web search rather than after it. What comes back is evidence:
# the publisher, the URL, the date and the rating as written. Nothing here is a
# verdict on a submitted claim, and there is no aggregate rating field anywhere in
# the response.
#
# google
FACT_CHECK_PROVIDER=google

# Free, and separate from the search keys — a deployment with search keys and no
# fact-check key is the common case, not a fault. Get one from a Google Cloud
# project with the Fact Check Tools API enabled. Left empty, the lookup is reported
# as `skipped` on `fact_checkers` and `fact_checked` is false; the web search is
# unaffected and `complete` stays true.
GOOGLE_FACT_CHECK_API_KEY=
FACT_CHECK_TIMEOUT_SECONDS=20

# Total tries per request, not retries: 1 disables retrying. Same policy as
# SEARCH_ATTEMPTS: only 429, 5xx and connection failures are retried. A timeout is
# not — it has already spent the caller's budget once.
FACT_CHECK_ATTEMPTS=3

# Records requested per claim. Only the first page is ever read, so this is the
# hard ceiling on records per claim rather than a batch size. A claim with more
# than ten published fact checks is a famous one and the eleventh will not change
# the picture.
FACT_CHECK_MAX_RESULTS=10

# BCP-47 language to restrict reviews to. Empty means no restriction, which is the
# default on purpose: filtering to `en` would hide a Spanish-language fact check of
# a Spanish-language claim. The reading vocabulary is English-only, so a rating it
# cannot read arrives as `unrecognised` with the publisher's own words intact — the
# URL, the outlet and the verdict as written all still reach the client.
FACT_CHECK_LANGUAGE=

# Ignore reviews older than this many days. 0 means no limit, because a fact check
# does not expire: the 2016 debunk is the reason the rumour is known to be false,
# and a window would drop it while keeping this month's re-circulation unreviewed.
FACT_CHECK_MAX_AGE_DAYS=0

# Concurrent in-flight lookups. Low for the reason SEARCH_CONCURRENCY is: the quota
# is per-key and daily, and one request per claim is already the fewest requests
# this can take.
FACT_CHECK_CONCURRENCY=2

# How much of the claim a record must repeat to count as being about it, on the same
# 0-1 scale as evidence relevance. Low deliberately — the two failure directions are
# not symmetric. A record that slips through arrives with the fact-checker's own
# wording attached, so a reader can see it is about something adjacent; a record
# wrongly excluded becomes a silent "nobody has reviewed this claim".
FACT_CHECK_MIN_MATCH=0.15

# ============================================================= vector store ==
# chroma | faiss
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./var/chroma
FAISS_INDEX_PATH=./var/faiss/index.faiss

# Which provider turns text into vectors. Resolved separately from LLM_PROVIDER
# because embedding and generation are different capabilities: a deployment
# generating text with OpenAI has not thereby configured anything that embeds.
# Only `hashing` is registered today — it needs no key and no network, and its
# similarity measures shared vocabulary rather than meaning. Naming any other
# provider here fails at startup with an unregistered-provider error rather than
# silently degrading.
EMBEDDING_PROVIDER=hashing

# Vector width. Changing it invalidates an existing index — the vectors already in
# it are a different shape. EMBEDDING_MODEL is read by no embedder yet; it is here
# for a future API-backed one, where it would have to agree with the dimension
# count that model emits.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ======================================================= evidence retrieval ==
# Whether the fact-check desk indexes a run's passages and retrieves against them.
# Off is a degradation and not a different result: retrieval is a second reading of
# evidence already gathered and already scored, so what it changes is which passages
# a reader is shown first — never the verdict or the confidence score.
EVIDENCE_INDEX_ENABLED=true

# How many passages the index returns per claim. Above the per-source evidence cap
# on purpose: that one bounds what a single page contributes, this one reaches across
# every source found for the claim.
EVIDENCE_TOP_K=8

# Cosine similarity below which a retrieved passage is dropped. A vector store always
# answers — it returns its nearest neighbours however far away they are — so without
# a floor the least relevant passage in a small index reads as relevant. Low, because
# this cuts off noise rather than ranking; the ordering above it is the store's.
EVIDENCE_MIN_SIMILARITY=0.05

# ============================================================ claim extraction ==
# spacy
CLAIM_EXTRACTOR=spacy

# The spaCy pipeline to load. NOT installed by `pip install -r requirements.txt` —
# spaCy models are separate artifacts, so a deploy needs its own step:
#   python -m spacy download en_core_web_sm
# NLTK's data is the same story:
#   python -m nltk.downloader punkt_tab stopwords
# Missing the spaCy model is a 500 naming the command; missing the NLTK data only
# logs a warning and falls back to spaCy's sentence boundaries.
SPACY_MODEL=en_core_web_sm

# Fewest content-bearing tokens a clause needs before it is worth checking. Four
# admits "The bridge opened in March" and rejects "It did."
CLAIM_MIN_TOKENS=4

# How many keywords to return per claim and for the document as a whole.
CLAIM_MAX_KEYWORDS=10

# Ceiling on sentences read from one submission. MAX_TEXT_CHARS bounds the bytes
# but not the work. The response reports how many were read, so hitting this is
# visible to a client rather than looking like an empty tail.
CLAIM_MAX_SENTENCES=400

# ================================================================== uploads ==
# Ceiling on a submitted artifact, in bytes. 50 MiB.
MAX_UPLOAD_BYTES=52428800

# Ceiling on submitted prose, in characters. Applies to the JSON path — a pasted
# article or a claim — which MAX_UPLOAD_BYTES does not cover.
MAX_TEXT_CHARS=100000
